---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageFigure from './PageFigure.astro';
import ProviderRegister from './ProviderRegister.astro';
import { asideGroupOf, besideTheRegister, loadFacets } from '../lib/facets';
import { licenceUrl, providerList, publisherRef, websiteRef } from '../lib/seo';

/**
 * A group that sits beside the register: the ones that stopped trading, the
 * companies that sell no hosting, the records we have not finished.
 *
 * One template for all three, and the writing in a note under
 * src/content/notes/aside/ — the same arrangement as a facet value page, for
 * the same reason. Three pages that each carried their own prose in an Astro
 * file were three places to keep a paragraph, and prose in a template is prose
 * nobody edits.
 */
interface Props {
  /** Which group: the key is the note, the page and the word the register links. */
  group: string;
  /** Kept out of search engines. True of the stubs, which are our working state rather than an answer. */
  hidden?: boolean;
}

const { group, hidden } = Astro.props;
const { key, label, rows } = await asideGroupOf(group);
const { facets } = await loadFacets();

const notes = await getCollection('notes');
const note = notes.find((entry) => entry.id === `aside/${key}`);
const Note = note ? (await render(note)).Content : null;

/*
 * One string, for the reason given in ProviderRegister.astro — and the same
 * sentence for every group, because the fact they have in common is the fact
 * that matters: they are not the register.
 */
const { providers: register } = await loadFacets();
const number = new Intl.NumberFormat('en');

/* What puts a record in each group, so the page says what it holds as well as how many. */
const holds: Record<string, string> = {
  defunct: 'ended: the repository is archived, the package is deprecated, or the project says it has stopped',
  stubs: 'checked but not listed yet: in doubt on a criterion, or without a release in four years',
  hosted: 'offered only as a hosted service, with nothing to install',
  boundary: 'not yet decided whether they belong in the directory',
};

/* The other groups, linked, so each page names what it leaves out. */
const others = (await besideTheRegister()).filter((other) => other.key !== key && other.key !== 'all' && other.count > 0);
const counted =
  key === 'all'
    ? {
        lead: `${number.format(rows.length)} listed: `,
        strong: `${number.format(register.length)} with momentum`,
        tail: `, shown on the home page, and ${number.format(rows.length - register.length)} without.`,
      }
    : {
        lead: '',
        strong: `${number.format(rows.length)} ${rows.length === 1 ? 'project' : 'projects'}`,
        tail: holds[key] ? ` ${holds[key]}. Not in the home page count or the full list; each keeps its page.` : ', kept out of the home page count and the full list.',
      };

const origin = Astro.site?.origin ?? '';
---

<Base
  graph="rows"
  title={`${note?.data.title ?? label} — FindSoftware`}
  description={note?.data.description}
  hidden={hidden}
  schema={[
    {
      '@type': 'CollectionPage',
      url: `${origin}/${key}/`,
      name: note?.data.title ?? label,
      ...(note?.data.description ? { description: note.data.description } : {}),
      inLanguage: 'en',
      isPartOf: websiteRef(origin),
      publisher: publisherRef(origin),
      license: licenceUrl,
      mainEntity: providerList(origin, rows),
    },
  ]}
>
  {/* The word that was clicked to get here, so arriving needs no second reading. */}
  <div class="page-head">
    <h1>{label}</h1>
  </div>

  <PageFigure figure={note?.data.figure} />

  {Note && <Note />}

  <p class="annotation">
    {counted.lead}<strong>{counted.strong}</strong>{counted.tail}
    {
      others.length > 0 && (
        <>
          {' Elsewhere: '}
          {others.map((other, index) => (
            <>
              <a class="quiet-link" href={other.href}>{`${number.format(other.count)} ${other.count === 1 ? other.label.toLowerCase().replace(/s$/, '') : other.label.toLowerCase()}`}</a>
              {index < others.length - 1 ? ', ' : '.'}
            </>
          ))}
        </>
      )
    }
    {
      key === 'all' && (
        <>
          {' '}
          <a href="/about/#momentum">What decides momentum</a>
        </>
      )
    }
  </p>

  {
    /* The register's own list, letters and all: one list on the site, however it was narrowed. */
    rows.length > 0 ? (
      <ProviderRegister providers={rows} facets={facets} bare />
    ) : (
      <p class="annotation">
        Nothing here yet. The group exists because the dataset can describe it, and it will fill as records are checked.
      </p>
    )
  }
</Base>

{/* For the extended/slim toggle only. These pages ship no filters — the group is the narrowing. */}
<script>
  import '../scripts/find.ts';
</script>
