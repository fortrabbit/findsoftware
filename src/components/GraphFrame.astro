---
import zoomIn from 'bootstrap-icons/icons/zoom-in.svg?raw';
import zoomOut from 'bootstrap-icons/icons/zoom-out.svg?raw';
import fullscreen from 'bootstrap-icons/icons/fullscreen.svg?raw';
import fonts from 'bootstrap-icons/icons/fonts.svg?raw';
import chevron from 'bootstrap-icons/icons/chevron-up.svg?raw';

/*
 * The one graph of the site, rendered once by Base.astro and kept by the router
 * across page loads. Each page names what it shows on <main data-graph-show>.
 */
const controls: { value: string; label: string; icon: string; pressed?: boolean }[] = [
  { value: 'in', label: 'Zoom in', icon: zoomIn },
  { value: 'out', label: 'Zoom out', icon: zoomOut },
  { value: 'expand', label: 'Whole screen (Esc to leave)', icon: fullscreen, pressed: false },
  { value: 'labels', label: 'Show names', icon: fonts, pressed: false },
  { value: 'collapse', label: 'Hide the graph', icon: chevron, pressed: false },
];
---

<div class="graph" role="region" data-graph aria-label="What each project is built on">
  <div class="graph-canvas" data-graph-canvas></div>
  <p class="graph-note" data-graph-note hidden></p>
  <div
    class="graph-handle"
    role="separator"
    aria-orientation="vertical"
    aria-label="Graph width"
    aria-valuemin="320"
    title="Drag to resize, double-click to reset"
    tabindex="0"
    data-graph-handle
  >
  </div>
  <div class="graph-controls" role="group" aria-label="Graph view" data-graph-controls>
    {
      controls.map((control) => (
        <button type="button" value={control.value} data-tip={control.label} aria-pressed={control.pressed}>
          <span class="visually-hidden">{control.label}</span>
          {control.value === 'collapse' && (
            <span class="graph-fold-text" aria-hidden="true">
              Graph
            </span>
          )}
          <Fragment set:html={control.icon} />
        </button>
      ))
    }
  </div>
</div>

<script>
  import type { mountGraph } from '../scripts/graph';

  /*
   * The data and the renderer load once per visit, after the first page that
   * shows the graph has painted; a page without the graph loads neither.
   * Every page load after that only tells the graph what to show.
   */
  const dock = document.querySelector<HTMLElement>('[data-graph-dock]')!;
  const root = dock.querySelector<HTMLElement>('[data-graph]')!;
  let mounted: Promise<ReturnType<typeof mountGraph> | undefined> | undefined;
  let broken = false;

  const mount = () =>
    (mounted ??= Promise.all([import('../scripts/graph'), fetch('/graph.json').then((response) => response.json())])
      .then(([{ mountGraph }, data]) => mountGraph(root, data))
      // An empty frame says nothing; without the data every page still names its relations.
      .catch(() => {
        broken = true;
        dock.hidden = true;
        return undefined;
      }));

  const stateOf = (page: Document) => page.querySelector<HTMLElement>('main')?.dataset.graphShow ?? 'off';
  const note = root.querySelector<HTMLElement>('[data-graph-note]')!;
  // Before the swap, not on page-load: the router shows the new page first, and a column decided late reflows it.
  const prepare = (page: Document) => {
    dock.hidden = broken || stateOf(page) === 'off';
    note.textContent = page.querySelector<HTMLElement>('main')?.dataset.graphNote ?? '';
    note.hidden = !note.textContent;
  };
  prepare(document);
  document.addEventListener('astro:before-swap', (event) => prepare(event.newDocument));
  document.addEventListener('astro:page-load', () => {
    const state = stateOf(document);
    dock.hidden = broken || state === 'off';
    describeWidth();
    if (dock.hidden) return;
    if (mounted) return void mounted.then((graph) => graph?.show(state));
    const idle = window.requestIdleCallback ?? ((run: () => void) => setTimeout(run, 1));
    idle(() => void mount().then((graph) => graph?.show(state, true)));
  });

  /*
   * The column's left edge drags. The width lives on the root as --graph-drag,
   * where the theme script in Base.astro restores it before the first paint and
   * on every page the router brings in. Bounded so neither side disappears.
   */
  const handle = root.querySelector<HTMLElement>('[data-graph-handle]')!;
  const bounds = (width: number) => Math.round(Math.min(Math.max(width, 320), innerWidth * 0.7));
  // The separator's range, as a screen reader reads it: where it is, and how far it goes either way.
  function describeWidth() {
    handle.setAttribute('aria-valuemax', String(Math.round(innerWidth * 0.7)));
    handle.setAttribute('aria-valuenow', String(Math.round(root.offsetWidth)));
  }
  addEventListener('resize', describeWidth);
  const setWidth = (width: number | undefined) => {
    const style = document.documentElement.style;
    try {
      if (width === undefined) localStorage.removeItem('graph-width');
      else localStorage.setItem('graph-width', String(width));
    } catch {}
    if (width === undefined) style.removeProperty('--graph-drag');
    else style.setProperty('--graph-drag', `${width}px`);
    describeWidth();
  };
  handle.addEventListener('pointerdown', (event) => {
    event.preventDefault();
    handle.setPointerCapture(event.pointerId);
    document.documentElement.classList.add('graph-dragging');
    // One drag, one set of listeners, all gone when it ends however it ends.
    const drag = new AbortController();
    const stop = () => {
      document.documentElement.classList.remove('graph-dragging');
      drag.abort();
    };
    handle.addEventListener('pointermove', (next) => setWidth(bounds(innerWidth - next.clientX)), {
      signal: drag.signal,
    });
    handle.addEventListener('pointerup', stop, { signal: drag.signal });
    handle.addEventListener('pointercancel', stop, { signal: drag.signal });
  });
  handle.addEventListener('dblclick', () => setWidth(undefined));
  handle.addEventListener('keydown', (event) => {
    const step = { ArrowLeft: 32, ArrowRight: -32 }[event.key];
    if (!step) return;
    event.preventDefault();
    setWidth(bounds(root.offsetWidth + step));
  });

  /*
   * Above the page, on a narrow screen, the graph folds to a strip. Phones start
   * folded; a reader's own choice is kept, where storage allows it.
   */
  const fold = root.querySelector<HTMLButtonElement>('button[value="collapse"]')!;
  const setFolded = (folded: boolean) => {
    root.classList.toggle('collapsed', folded);
    // The name stays "Hide the graph" and pressed says it is hidden; only the drawn tip reads as the next move.
    fold.setAttribute('aria-pressed', String(folded));
    fold.dataset.tip = folded ? 'Show the graph' : 'Hide the graph';
  };
  let stored: string | null = null;
  try {
    stored = localStorage.getItem('graph-folded');
  } catch {}
  setFolded(stored ? stored === 'true' : matchMedia('(max-width: 40rem)').matches);
  fold.addEventListener('click', () => {
    const folded = !root.classList.contains('collapsed');
    setFolded(folded);
    try {
      localStorage.setItem('graph-folded', String(folded));
    } catch {}
  });
</script>

<style>
  .graph {
    position: relative;
    height: var(--graph-height, 20rem);
    border: var(--rule-hairline) solid var(--color-ink);
    background: var(--color-page);
  }
  .graph-canvas {
    height: 100%;
    /* While a resize settles the canvas keeps its old size; what overhangs is cut, not spilled over the page. */
    overflow: hidden;
  }
  /* Folded, the controls stay as a strip, so the graph can be unfolded again. Only above the page: the column never folds. */
  @media (max-width: 63.99rem) {
    .graph.collapsed {
      height: calc(var(--space-sm) * 2 + 1.75rem);
    }
    .graph.collapsed .graph-canvas,
    .graph.collapsed .graph-note {
      visibility: hidden;
    }
    .graph.collapsed .graph-fold-text {
      display: inline;
    }
    .graph.collapsed .graph-controls button:not([value='collapse']) {
      display: none;
    }
    .graph.collapsed button[value='collapse'] {
      background: var(--color-page);
      color: var(--color-ink);
    }
    .graph.collapsed button[value='collapse'] :global(svg) {
      transform: rotate(180deg);
    }
  }
  /* The column never folds, so it has no fold control; as specific as the rule that shows the controls. */
  @media (min-width: 64rem) {
    .graph-controls button[value='collapse'] {
      display: none;
    }
  }
  /* A strip over the column's left rule; only the column resizes, above the page there is nothing to drag. */
  .graph-handle {
    display: none;
  }
  @media (min-width: 64rem) {
    .graph:not(.expanded) .graph-handle {
      position: absolute;
      z-index: 1;
      top: 0;
      bottom: 0;
      left: -0.3rem;
      display: block;
      width: 0.6rem;
      cursor: col-resize;
      touch-action: none;
    }
    .graph-handle:hover,
    .graph-handle:focus-visible,
    :global(.graph-dragging) .graph-handle {
      background: linear-gradient(to right, transparent 40%, var(--color-link) 40% 60%, transparent 60%);
      outline: none;
    }
  }
  /* While dragging, the pointer may cross text; nothing gets selected and the cursor holds. */
  :global(.graph-dragging) {
    cursor: col-resize;
    user-select: none;
  }
  /* Over everything, the whole screen to explore; Escape or the control brings it back. */
  .graph.expanded {
    position: fixed;
    z-index: 10;
    inset: 0;
    height: auto;
    border: 0;
  }
  .graph.expanded .graph-controls button[value='collapse'] {
    display: none;
  }
  /* On the header's line: the same distance from the top and the right as the nav from the top and the left. */
  /* Why the graph shows what it shows, where the page's own record is not in it. */
  .graph-note {
    position: absolute;
    bottom: var(--space-md);
    left: var(--space-md);
    max-width: calc(100% - 2 * var(--space-md));
    margin: 0;
    padding: var(--space-3xs) var(--space-2xs);
    border: var(--rule-hairline) solid var(--color-ink);
    background: var(--color-page);
    font-family: var(--font-data);
    font-size: var(--text-xs);
  }
  /* Folded, the strip says what it holds. */
  .graph-fold-text {
    display: none;
    margin-right: var(--space-2xs);
    font-family: var(--font-data);
    font-size: var(--text-xs);
  }
  .graph-controls {
    position: absolute;
    top: var(--space-md);
    right: var(--space-md);
    display: flex;
    gap: var(--space-3xs);
  }
  .graph-controls button {
    display: inline-flex;
    padding: var(--space-3xs) var(--space-2xs);
    border: var(--rule-hairline) solid var(--color-ink);
    border-radius: var(--radius);
    background: var(--color-page);
    color: var(--color-ink);
    cursor: pointer;
  }
  .graph-controls button[aria-pressed='true'] {
    background: var(--color-ink);
    color: var(--color-page);
  }
  .graph-controls :global(svg) {
    width: 1em;
    height: 1em;
  }
</style>
