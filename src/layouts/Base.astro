---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import { ClientRouter } from 'astro:transitions';
import GraphFrame from '../components/GraphFrame.astro';
import { outboundLinkAttrs } from '../lib/links';
import { graph, licenceUrl } from '../lib/seo';

interface Props {
  title: string;
  description?: string;
  /** Path to the same page as markdown, announced for readers that prefer text. */
  markdown?: string;
  /** Path to the same record as JSON, with every source. */
  json?: string;
  /**
   * The page carries the markdown link itself, so the footer does not. A record
   * puts it in the row beside its review date and its edit link, where it reads
   * as one set of things to do with the page rather than as a stray line under
   * the site's own credits.
   */
  markdownInPage?: boolean;
  /** A record kept for reference but not on show: out of the index and out of search, whatever the site-wide flag says. */
  hidden?: boolean;
  /** This page's share card, site-root relative. Records draw their own; every other page shares the register's. */
  image?: string;
  /** What the card shows, for a reader who is hearing the link rather than seeing it. */
  imageAlt?: string;
  /**
   * Structured data for this page. One object, or several where the page makes
   * more than one claim about itself. Emitted as one graph beside the publisher
   * and the site, which the nodes refer to by `@id`; shapes in lib/seo.ts.
   */
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /**
   * What the graph beside the page shows: `all`, `off`, `record:<id>`,
   * `hub:<key>`, `rows` (the records listed on the page) or `register` (the
   * rows the filters leave). Read by the graph on every page load.
   */
  graph?: string;
  /** A line over the graph saying why it shows what it shows, where the page's own subject is not in it. */
  graphNote?: string;
  /**
   * One level up from this page: the link Escape follows and the crumb's last
   * step. Every page but the register has one; it defaults to the register.
   */
  up?: { href: string; label: string };
}

const {
  title,
  description,
  markdown,
  json,
  markdownInPage = false,
  hidden = false,
  image = '/og/default.png',
  imageAlt = 'A FindSoftware card: the register of software to build websites with.',
  schema,
  graph: graphState = 'all',
  graphNote,
} = Astro.props;
const fathomSiteId = import.meta.env.PUBLIC_FATHOM_SITE_ID;

// Belt and braces with robots.txt: the file stops the crawl, this stops a URL
// someone links to from being listed anyway.
const indexable = import.meta.env.PUBLIC_INDEXABLE === 'true' && !hidden;

/*
 * The writing about the register. The register itself is the homepage, which the
 * wordmark already leads back to; the map is reached from the pages that need
 * it — a nav that lists everything is a nav nobody reads.
 */
const sections = [{ href: '/about/', label: 'About' }];

const path = Astro.url.pathname;
// The register is the top; a filtered register goes up to the unfiltered one, which the script decides.
const up = Astro.props.up ?? { href: '/', label: 'All software' };
const origin = Astro.site ?? Astro.url;
const canonical = new URL(path, origin).href;

/*
 * Absolute, because a share card is fetched by a machine that has no page to
 * resolve a relative path against. Dimensions are stated so the preview reserves
 * the right shape before the image arrives.
 */
const card = new URL(image, origin).href;

const structured = schema && graph(new URL(origin).origin, Array.isArray(schema) ? schema : [schema]);
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} />}
    {json && <link rel="alternate" type="application/json" href={json} />}
    {/* RFC 8631: where the published files are described for a machine. */}
    <link rel="service-desc" type="application/openapi+json" href="/openapi.json" />
    <link rel="canonical" href={canonical} />
    {/* The permission, in the head, where something that is not reading the prose can find it. */}
    <link rel="license" href={licenceUrl} />
    <link rel="alternate" type="application/atom+xml" title="FindSoftware — recently checked" href="/feed.xml" />

    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="FindSoftware" />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={card} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    {/* Pages swap in place, so the graph beside them survives a link; without JavaScript links load pages as ever. */}
    <ClientRouter fallback="swap" />
    {
      structured && (
        <script type="application/ld+json" set:html={JSON.stringify(structured).replace(/</g, '\\u003c')} is:inline />
      )
    }
    {fathomSiteId && <script is:inline src="https://cdn.usefathom.com/script.js" data-site={fathomSiteId} defer />}
  </head>
  <body data-pagefind-ignore={hidden ? 'all' : undefined}>
    <header data-pagefind-ignore>
      <a href="/" class="wordmark" aria-current={path === '/' ? 'page' : undefined}>FindSoftware</a>

      <nav class="site-nav">
        {
          sections.map((section) => (
            <a href={section.href} aria-current={path.startsWith(section.href) ? 'page' : undefined}>
              {section.label}
            </a>
          ))
        }
      </nav>
    </header>

    <main data-graph-show={graphState} data-graph-note={graphNote}>
      {
        /*
         * The way up, on every page: a page names its own trail, the rest sit right
         * under Home. The Esc key after it links one level up, where Escape goes.
         * The unfiltered register is the top and hides it; the script shows it once
         * a filter is set.
         */
      }
      <nav class="crumb" aria-label="Breadcrumb" data-pagefind-ignore hidden={path === '/'}>
        <slot name="crumb"><a href="/">Home</a></slot>
        <a class="crumb-key" href={up.href} rel="up" data-move="up" title={`Esc goes up to ${up.label}`}>
          <span class="visually-hidden">Up to {up.label}</span>
          <kbd aria-hidden="true">Esc</kbd>
        </a>
      </nav>
      <slot />
    </main>

    {
      /*
       * Kept across page loads: the router moves this element into the next
       * page as it is, with its canvas and its state. Rendered on every page,
       * also where it stays hidden, because the router only keeps an element
       * the next page has too. Its attributes stay the first page's, so each
       * page says what the graph shows on <main data-graph-show> instead.
       * After <main> in the source, so Tab reaches the page before the graph;
       * the stylesheet places it.
       */
    }
    <div class="graph-dock" transition:persist="graph" hidden={graphState === 'off'} data-graph-dock>
      <GraphFrame />
    </div>

    <footer data-pagefind-ignore>
      <div class="footer-base">
        <div>
          <p>
            Designed and curated by Frank Lämmer of <a
              href="https://www.fortrabbit.com"
              {...outboundLinkAttrs('https://www.fortrabbit.com')}>fortrabbit</a
            >.
          </p>
          {
            /*
             * Destinations rather than a sentence, so they take a row and a gap
             * and no full stops. "Add a provider" is the errand a provider
             * arrives with and the only one they have a page of their own for —
             * correcting a record, naming a missing one and the badge are all
             * on it, and it sends them into GitHub knowing which form they want.
             */
          }
          <nav class="footer-nav" aria-label="Elsewhere">
            {
              /* Search is a page of its own: the register answers Cmd-F, so a field on every page was weight for little. */
            }
            <a href="/search/">Search</a>
            <a href="/about/">About</a>
            <a href="/criteria/">Listing criteria</a>

            <a
              href="https://github.com/fortrabbit/findsoftware"
              {...outboundLinkAttrs('https://github.com/fortrabbit/findsoftware')}
            >
              GitHub
            </a>
          </nav>
          {
            /*
             * The same twin the `<link rel="alternate">` in the head announces,
             * as an anchor. A crawler that only reads body links never sees the
             * head, and the markdown copy is the form this site would rather be
             * read in by anything that is not a browser.
             */
          }
          {
            markdown && !markdownInPage && (
              <p>
                <a href={markdown}>This page as markdown</a>.
              </p>
            )
          }
        </div>
        {
          /*
          Three choices rather than a switch between two, because there are three
          — and the third, letting the operating system decide, was unreachable
          the moment anybody pressed the old one. Absent until the script runs;
          the `js` class decides that before first paint.
        */
        }
        <div class="theme-switch" role="group" aria-label="Theme">
          {
            /*
            Drawn rather than typed. ◑ ○ ● are glyphs, and a glyph sits where its
            font puts it — which is why the half-circle looked centred in one
            browser and low in another. A circle in a viewBox is in the middle of
            it everywhere.
          */
          }
          <button type="button" data-theme-set="system">
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path d="M8 2a6 6 0 0 0 0 12z" fill="currentColor"></path>
              <circle cx="8" cy="8" r="6" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
            </svg>
            <span class="visually-hidden">System</span>
          </button>
          <button type="button" data-theme-set="light">
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <circle cx="8" cy="8" r="6" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
            </svg>
            <span class="visually-hidden">Light</span>
          </button>
          <button type="button" data-theme-set="dark">
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <circle cx="8" cy="8" r="6" fill="currentColor"></circle>
            </svg>
            <span class="visually-hidden">Dark</span>
          </button>
        </div>
      </div>
    </footer>

    <script is:inline>
      // A block, so a second run of this script declares nothing twice.
      {
        // Before first paint, or the page flashes the wrong theme on the way in.
        // Guarded: a browser that blocks site data throws on the accessor, and
        // the `js` class below has to be set regardless.
        const settle = (root) => {
          try {
            const stored = localStorage.getItem('theme');
            if (stored === 'dark' || stored === 'light') root.dataset.theme = stored;
            // The graph column's width, as the reader last dragged it.
            const width = Number(localStorage.getItem('graph-width'));
            if (width) root.style.setProperty('--graph-drag', `${width}px`);
            // A graph the reader closed stays out of the layout from the first paint.
            root.classList.toggle('graph-closed', localStorage.getItem('graph-closed') === 'true');
          } catch {}

          /*
           * Same reason. The filter panel is static markup and ships visible, so a
           * crawler reads its links and a reader sees it immediately; the controls
           * inside it only work once find.ts has run. This says which world we are
           * in early enough that nothing appears, disappears or moves afterwards.
           */
          root.classList.add('js');
        };
        settle(document.documentElement);
        // The router copies the next page's <html> attributes over this one's, which drops both; set them on the new page before it shows.
        document.addEventListener('astro:before-swap', (event) => settle(event.newDocument.documentElement));
      }
    </script>

    <script>
      import { navigate } from 'astro:transitions/client';

      const root = document.documentElement;
      // The footer arrives anew with every page, so the buttons are looked up again each time.
      let choices: NodeListOf<HTMLButtonElement>;

      /*
       * Each button is a state rather than a move, so each says whether it is the
       * one in force. `aria-pressed` is right here for the reason it was wrong
       * before: these announce what the theme *is*, not what pressing will do.
       */
      const describe = () => {
        const setting = root.dataset.theme ?? 'system';
        for (const choice of choices) {
          const mine = choice.dataset.themeSet === setting;
          choice.setAttribute('aria-pressed', String(mine));
          choice.title =
            choice.dataset.themeSet === 'system' ? 'Follow the system' : `Always ${choice.dataset.themeSet}`;
        }
      };

      const wire = () => {
        choices = document.querySelectorAll<HTMLButtonElement>('[data-theme-set]');
        for (const choice of choices) {
          choice.addEventListener('click', () => {
            const wanted = choice.dataset.themeSet!;

            // System is the absence of a choice, so choosing it removes one.
            if (wanted === 'system') delete root.dataset.theme;
            else root.dataset.theme = wanted;

            try {
              if (wanted === 'system') localStorage.removeItem('theme');
              else localStorage.setItem('theme', wanted);
            } catch {
              /* Storage blocked: the theme still applies for this page. */
            }

            describe();
          });
        }
        describe();
      };
      document.addEventListener('astro:page-load', wire);

      // Up is off on the unfiltered register, the top.
      const upLink = () => document.querySelector<HTMLAnchorElement>('[data-move="up"]');
      const atTop = () => location.pathname === '/' && !location.search;
      const moves = () => {
        const link = upLink();
        if (link) {
          link.toggleAttribute('aria-disabled', atTop());
          link.tabIndex = atTop() ? -1 : 0;
        }
        document.querySelector('main > .crumb')?.toggleAttribute('hidden', atTop());
      };
      document.addEventListener('astro:page-load', moves);
      // Filtering changes the address in place; up from a filtered register clears it.
      document.addEventListener('find:results', moves);
      document.addEventListener('click', (event) => {
        if ((event.target as Element).closest('[data-move="up"]') && atTop()) event.preventDefault();
      });

      // Escape goes up, unless something on the page holds it: a field, an open dialog, the graph over the whole screen.
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape' || event.defaultPrevented || event.metaKey || event.ctrlKey || event.altKey) return;
        if ((event.target as Element).closest?.('input, textarea, select, [contenteditable]')) return;
        if (document.querySelector('dialog[open], .graph.expanded')) return;
        const link = upLink();
        if (!link || atTop()) return;
        event.preventDefault();
        void navigate(link.href);
      });

      // `/` searches, the way it works everywhere else a developer types: the field on the search page, or that page.

      document.addEventListener('keydown', (event) => {
        if (event.key !== '/' || event.metaKey || event.ctrlKey || event.altKey) return;

        const active = document.activeElement;
        const typing =
          active instanceof HTMLInputElement ||
          active instanceof HTMLTextAreaElement ||
          (active instanceof HTMLElement && active.isContentEditable);
        if (typing) return;

        event.preventDefault();
        const field = document.querySelector<HTMLInputElement>('[data-search-input]');
        if (!field) return void navigate('/search/');
        field.focus();
        field.select();
      });
    </script>
  </body>
</html>
