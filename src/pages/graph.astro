---
import Base from '../layouts/Base.astro';
import GraphFrame from '../components/GraphFrame.astro';

/*
 * What the register is built on, drawn. Without JavaScript there is no graph;
 * each record page names its parents, so the facts stay reachable.
 */
const description = 'What each project in the register is built on, from the language outwards.';
---

<Base title="Graph — FindSoftware" description={description}>
  <h1 class="visually-hidden">Graph</h1>

  <noscript><p>The graph needs JavaScript. Each record page names what the software is built on.</p></noscript>
  <div class="full-width graph-frame">
    <GraphFrame />
  </div>
</Base>

<style>
  /* Close to the edges: the graph is scanned, and every pixel of width spreads it out. */
  .graph-frame {
    padding-inline: var(--space-xs);
  }
</style>
