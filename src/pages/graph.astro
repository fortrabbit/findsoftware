---
import { loadGraph } from '../lib/graph-data';

/*
 * The graph is beside every page now, so its old page only forwards: a shared
 * /graph/#<id> to that record, anything else to the register. The hash never
 * reaches a server, so the map from id to page travels with the page.
 */
const { nodes } = await loadGraph();
const pages = Object.fromEntries(nodes.filter((node) => node.href).map((node) => [node.key, node.href]));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content="0; url=/" />
    <link rel="canonical" href={new URL('/', Astro.site ?? Astro.url).href} />
    <title>Graph — FindSoftware</title>
    <script is:inline define:vars={{ pages }}>
      let key = '';
      try {
        key = decodeURIComponent(location.hash.slice(1));
      } catch {}
      location.replace(Object.hasOwn(pages, key) ? pages[key] : '/');
    </script>
  </head>
  <body>
    <p><a href="/">The graph is on the register now.</a></p>
  </body>
</html>
