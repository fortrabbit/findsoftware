# Canonical origin for absolute URLs (canonicals, OG tags, sitemap).
# Set this per environment — a vanity URL now, the real domain later.
SITE_URL=http://localhost:4321

# Fathom analytics site ID. Unset means no script tag is rendered at all.
PUBLIC_FATHOM_SITE_ID=

# Set to true at launch. Until then robots.txt disallows everything and every
# page carries noindex, so the link can be shared without being indexed.
PUBLIC_INDEXABLE=false

# FindHost's address, for the links from each record to hosts that run it. Unset, no links.
FINDHOST_URL=
